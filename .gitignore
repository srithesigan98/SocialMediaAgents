# Python
__pycache__/
*.pyc

# The Watcher runtime artifacts (downloaded videos / extracted frames)
*.mp4
*.webm
*.jpg
*.jpeg
frames/
.watch-cache/

# Secrets
.env

# Hulk scripts
agents/hulk/scripts/venv/
agents/hulk/scripts/.env
agents/hulk/scripts/drafts/*
!agents/hulk/scripts/drafts/.gitkeep
agents/hulk/scripts/state/*
!agents/hulk/scripts/state/.gitkeep
# posters/ is intentionally NOT gitignored — daily_posts.py commits each rendered poster so
# Threads/Instagram can fetch it from its raw.githubusercontent.com URL (same pattern as the
# old hulk-daily.yml's posted_assets/).

# Blue Hulk scripts
agents/blue-hulk/scripts/venv/
agents/blue-hulk/scripts/.env
agents/blue-hulk/scripts/drafts/*
!agents/blue-hulk/scripts/drafts/.gitkeep

# Black Panther scripts
agents/black-panther/scripts/venv/
agents/black-panther/scripts/.env
agents/black-panther/scripts/drafts/*
!agents/black-panther/scripts/drafts/.gitkeep

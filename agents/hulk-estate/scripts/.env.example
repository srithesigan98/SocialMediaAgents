# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# Drafting (generate_property_post.py, daily_posts.py)
ANTHROPIC_API_KEY=

# Threads — same app/token flow as agents/hulk, but for your REAL ESTATE Threads account.
# Scopes needed: threads_basic, threads_content_publish, threads_manage_replies
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram — a Professional (Business/Creator) account with Instagram Login.
# Scopes needed: instagram_business_basic, instagram_business_content_publish,
#                instagram_business_manage_comments, instagram_business_manage_messages
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional: keep a private Google Sheet URL out of git (overrides listings.url in agent.yaml)
LISTINGS_URL=

# Optional: keep your closing number out of git (overrides whatsapp.number in agent.yaml)
WHATSAPP_NUMBER=

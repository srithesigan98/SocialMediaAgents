# Copy this file to .env and fill in real values. Never commit the real .env file.

# Used by daily_post.py to call Claude for the caption + poster slots.
ANTHROPIC_API_KEY=

# Instagram Graph API — same Meta app as Blue Hulk, with instagram_basic +
# instagram_content_publish scopes added to the Page token. See README.md for full setup.
IG_USER_ID=
IG_ACCESS_TOKEN=

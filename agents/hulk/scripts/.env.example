# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# One .env serves every Hulk profile; each profile names its own variables in its profile.yaml,
# so two brands' tokens can never be crossed.

# Drafting (all profiles)
ANTHROPIC_API_KEY=

# Which profile scripts use when --profile isn't passed.
HULK_PROFILE=senang-homes

# ---------------------------------------------------------------- TanSri | Millionaires (finance)
# Threads scopes: threads_basic, threads_content_publish
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ---------------------------------------------------------------- Senang Homes (real estate)
# Threads scopes: threads_basic, threads_content_publish, threads_manage_replies
SENANG_THREADS_USER_ID=
SENANG_THREADS_ACCESS_TOKEN=

# Instagram scopes: instagram_business_basic, instagram_business_content_publish,
#                   instagram_business_manage_comments, instagram_business_manage_messages
SENANG_IG_USER_ID=
SENANG_IG_ACCESS_TOKEN=

# Optional — keep these out of git instead of putting them in profile.yaml.
# Prefix with the profile name to scope them: SENANG_HOMES_LISTINGS_URL, SENANG_HOMES_WHATSAPP_NUMBER
LISTINGS_URL=
WHATSAPP_NUMBER=

# Copy this file to .env and fill in real values. Never commit the real .env file.

# Used by generate_draft.py to call Claude for drafting.
ANTHROPIC_API_KEY=

# Used by post_to_facebook.py — Meta Graph API.
# FB_PAGE_ID: your Facebook Page's numeric ID (Page → About → Page transparency / ID, or from
#   the /me/accounts Graph API response).
# FB_PAGE_ACCESS_TOKEN: a long-lived PAGE access token with pages_manage_posts +
#   pages_read_engagement. See scripts/README.md for the exact steps to generate one at
#   developers.facebook.com.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

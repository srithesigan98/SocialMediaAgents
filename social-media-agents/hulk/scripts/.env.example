# Copy this file to .env and fill in real values. Never commit the real .env file.

# Used by generate_draft.py to call Claude for drafting.
ANTHROPIC_API_KEY=

# Used by post_to_threads.py — Meta Threads API (graph.threads.net).
# THREADS_USER_ID is your Threads app-scoped user id; THREADS_ACCESS_TOKEN is a
# long-lived access token with threads_basic + threads_content_publish scopes.
# See: https://developers.facebook.com/docs/threads
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
